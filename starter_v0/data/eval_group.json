              "options": [
                "VPN",
                "email",
                "SSO",
                "Wi-Fi"
              ]
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_ambiguous_service",
        "difficulty": "medium",
        "what_it_tests": "Không được tự đoán dịch vụ khi yêu cầu chưa xác định hệ thống cần hỗ trợ."
      }
    },
