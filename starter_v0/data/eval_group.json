  "cases": [
    {
      "id": "G01_meeting_room_kb_limit",
      "phase": "B",
      "suite": "group",
      "query": "Tìm tối đa 5 hướng dẫn về cách xử lý thiết bị trình chiếu không hoạt động trong phòng họp.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "query": "thiết bị trình chiếu không hoạt động trong phòng họp",
              "category": "meeting_room",
              "top_k": 5
            }
          }
        ]
      },
      "metadata": {
        "skill": "kb_category_and_result_limit",
        "difficulty": "medium",
        "what_it_tests": "Nhận diện đúng nhóm meeting_room và truyền đúng giới hạn top_k=5 thay vì dùng giá trị mặc định."
      }
    },
    {
